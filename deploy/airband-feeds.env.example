# Secrets + ops knobs for the airband systemd units. Loaded via EnvironmentFile=
# by airband-feeds.service (the feeder), airband-watchdog.service and
# airband-alert@.service — all three see every variable below (the watchdog and
# alert hook only need AIRBAND_ALERT_URL + AIRBAND_WATCHDOG_*, but share the file
# for simplicity; split it if that bothers you).
#
# The AIRBAND_*_PASSWORD values are expanded into feeds.json's ${AIRBAND_*}
# references at startup, so the committed feeds.json never contains a password.
# Install on the Pi as:
#
#   sudo cp deploy/airband-feeds.env.example /etc/airband-feeds.env
#   sudo $EDITOR /etc/airband-feeds.env        # fill in the real passwords + an alert URL
#   sudo chown root:root /etc/airband-feeds.env
#   sudo chmod 600 /etc/airband-feeds.env
#   sudo systemctl restart airband-feeds airband-watchdog
#
# systemd's EnvironmentFile= parser (NOT a shell): one KEY=value per line, no
# `export`, no command substitution; quote a value containing spaces or '#'.
# Do NOT commit the filled-in file. *.env is gitignored; this *.example is the
# only env file tracked in the repo.

# Source password for the local Icecast server (icecast.chongflix.tv).
AIRBAND_ICECAST_PASSWORD=changeme

# Source password assigned by LiveATC for audio-in.liveatc.net:8010.
AIRBAND_LIVEATC_PASSWORD=changeme

# --- MQTT -> Home Assistant -----------------------------------------------
# airband-feeds.service passes --mqtt-broker/--mqtt-user from the first two vars.
# AIRBAND_MQTT_PASS is deliberately NOT a flag: the reader reads it straight from
# its environment, because a command-line value lands in /proc/<pid>/cmdline,
# which every local user (and `systemctl status`) can read.
# Leave AIRBAND_MQTT_BROKER empty (or unset) to disable MQTT — the reader treats
# an empty broker as "off", so the unit needs no separate MQTT-less variant.
# When set, the reader publishes a retained JSON state topic plus Home Assistant
# MQTT discovery configs (entities auto-appear, no manual YAML), and a Last Will
# flips availability to "offline" the instant the feeder dies.
AIRBAND_MQTT_BROKER=10.0.16.9
AIRBAND_MQTT_USER=plutoplus
AIRBAND_MQTT_PASS=changeme

# --- Failure alerting: SET THIS -------------------------------------------
# One line per event is produced by:
#   * airband-feeds.service's ExecStopPost hook (airband-alert.sh) — every crash,
#     WatchdogSec kill, OOM kill or start timeout of the feeder (a clean
#     stop/restart is silent);
#   * airband-watchdog.service — every recovery action it takes (feeder restart,
#     maia-httpd bounce, Pluto reboot), "ladder exhausted", reminders while still
#     down, and "recovered".
# Delivery, in order:
#   1. MQTT -> Home Assistant: automatic whenever AIRBAND_MQTT_BROKER above is set.
#      The line is published retained to <prefix>/last_alert and shows up in HA as
#      sensor.pluto_airband_last_alert (announced by the reader, with no
#      availability binding so it stays readable while the reader is dead). Put an
#      automation on its state changes — see deploy/README.md "Failure alerting".
#      Optional override of the topic prefix/port if the reader runs with
#      --mqtt-prefix / --mqtt-port:
#AIRBAND_MQTT_PREFIX=pluto-airband
#AIRBAND_MQTT_PORT=1883
#   2. Webhook or ntfy topic URL (optional, in addition): the same line is POSTed
#      here. A free ntfy topic (https://ntfy.sh/<something-unguessable>) gives a
#      phone push without going through HA.
# With neither configured ALL of the above is log-only: the feeder can crash-loop
# or sit on a dead Pluto for days and nobody is told. The 2026-09-07 watchdog kill
# and the 2026-10-01 MQTT hang were both invisible for exactly this reason. Test
# with `sudo systemctl start airband-alert@test` and watch
# sensor.pluto_airband_last_alert (or `mosquitto_sub -t pluto-airband/last_alert`).
#AIRBAND_ALERT_URL=https://ntfy.sh/your-secret-topic

# --- Optional: Pluto<->Pi watchdog (airband-watchdog.service) --------------
# Detects a capture that is really down — the reader's own systemd WatchdogSec
# deliberately keeps petting while it reconnects to an offline Pluto — and
# escalates recovery:
#   1. restart airband-feeds  2. bounce the Pluto's maia-httpd  3. reboot the Pluto.
# It acts only when /status is unreachable, stream_up=false or data_flowing=false
# for FAIL_THRESHOLD consecutive probes. A missed :8000 probe (pluto_reachable=
# false) while audio flows is logged as a warning and never counted: that probe
# blips ~20x/day and restarting a healthy feeder for it cost two needless 50 s
# outages. All knobs are OPTIONAL; the daemon ships safe defaults (shown). It
# polls the reader's /status heartbeat, so AIRBAND_METRICS_URL must match
# --metrics-port. Knobs are read from THIS file through the unit's
# EnvironmentFile= (the script does not source it), so a change takes effect on
# `systemctl restart airband-watchdog`.
#AIRBAND_METRICS_URL=http://127.0.0.1:9108
#AIRBAND_WATCHDOG_POLL_S=15                 # seconds between /status probes
#AIRBAND_WATCHDOG_FAIL_THRESHOLD=4          # consecutive down probes before acting (4*15s = 60s)
#AIRBAND_WATCHDOG_COOLDOWN_S=300            # min seconds between recovery actions, counted from the END of the
                                            # previous one; must exceed the feeder's TimeoutStartSec=180 so a
                                            # restarted feeder gets settling time before stage 2 (180 gave none).
                                            # Also the first "still down" reminder interval; reminders then
                                            # double each time, capped at 3600 s.
#AIRBAND_WATCHDOG_STARTUP_GRACE_S=120       # quiet period at boot while DFN models load
#AIRBAND_WATCHDOG_FEEDS_UNIT=airband-feeds.service
#AIRBAND_WATCHDOG_PLUTO_HOST=plutoplus.chongflix.tv
#AIRBAND_WATCHDOG_PLUTO_PASS=analog         # Pluto root password (device default); handed to sshpass via SSHPASS, never argv
#AIRBAND_WATCHDOG_PLUTO_SSH=                 # override the whole ssh command if you use keys, e.g. "ssh pluto"
# REBOOT_PLUTO: 1 = arm the Pluto-side stages (maia-httpd bounce + reboot over
# ssh). The script's built-in default is 1, but RECOMMENDED: set 0 (as below)
# until the ssh path is proven — on rf-pi /root/.ssh was empty and stages 2/3 had
# never actually run. The watchdog runs one `ssh true` to the Pluto after its
# startup grace period and logs "Pluto ssh check ...: ok" or the exact failure;
# flip this to 1 once that line reads ok. With 0 the ladder is: restart the
# feeder once, then alert and keep monitoring.
AIRBAND_WATCHDOG_REBOOT_PLUTO=0
#AIRBAND_WATCHDOG_REBOOT_PI=0               # 1 = last-resort Pi reboot (cannot fix a dead Pluto; default off)
