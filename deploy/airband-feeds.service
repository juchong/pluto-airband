[Unit]
Description=Pluto airband multichannel Icecast feeder (airband-reader --feeds)
Documentation=https://github.com/juchong/pluto-airband
After=network-online.target
Wants=network-online.target
# The Pluto serves a single client; never give up retrying if it restarts.
StartLimitIntervalSec=0
# No OnFailure= here, on purpose. This unit used to declare
# OnFailure=airband-alert@%n.service, but with Restart=always AND
# StartLimitIntervalSec=0 the unit can never enter the "failed" state: systemd
# only marks a restarting service failed once its start-rate limit trips, and
# that limit is disabled above, so every crash/watchdog kill goes straight to
# "activating (auto-restart)" and OnFailure= never fires (it did not fire for the
# 2026-09-07 watchdog kill). Crash alerting is done by ExecStopPost= below,
# which runs after EVERY stop and keys on $SERVICE_RESULT.

[Service]
# notify: the reader sends sd_notify(READY=1) once all DeepFilterNet models are
# loaded and the stream loop is starting, and pets WatchdogSec below from its
# live read loop, so a hung-but-alive reader (no data progressing) is restarted.
Type=notify
NotifyAccess=main
# Restart if no WATCHDOG=1 ping arrives within this window. The reader's watchdog
# keeper pings every 5 s for as long as its router thread is making progress
# (samples arriving, or reconnect attempts cycling while the Pluto is away), so a
# wedged router stops the pings within ~20 s and 30 s is ample slack.
WatchdogSec=30
# Eager DeepFilterNet model load for 18 channels happens before READY=1; give it
# room on a cold cache so systemd doesn't time out startup.
TimeoutStartSec=180
User=pi
WorkingDirectory=/home/pi/pluto-airband/host
# Source/LiveATC passwords are referenced as ${AIRBAND_*_PASSWORD} in feeds.json
# and expanded from the environment at startup, so no secret lives in the repo.
# Create this file as root:root, chmod 600 (see deploy/airband-feeds.env.example);
# it must NOT be committed to git.
EnvironmentFile=/etc/airband-feeds.env
# --channels 18: the operational plan is 18 positional channels (AWOS 118.050
# remains the firmware no-SD fallback only; 133.65 was added with the 16 MHz
# capture, which caps the channelizer at 18 ch / 6 lanes on the XC7Z010). Must
# equal len(channels_hz) in the Pluto's /mnt/sdcard/airband.json.
# --rate 20000: per-channel audio rate at the 16 MHz build (Fs / 160 / 5). Matches
# the airband-reader default; passed explicitly so the unit is self-documenting.
# --squelch carrier: gate on the FPGA AM-carrier byte, not voice-band VOX, so
# keyed transmissions open reliably even through speech pauses.
# --squelch-snr 11: dB above the LARGER of each channel's own adaptive carrier-noise
# floor and the live cross-channel common-mode reference. Every channel tracks its
# own idle baseline (EWMA sampled only while shut), so a single margin fits both a
# quiet channel and a comb-hot one (e.g. ch17/133.650) with no per-channel tuning,
# and the common-mode term makes a band-wide noise burst (a nearby transmitter)
# raise every channel's bar at once instead of false-opening. Balance point: 8 sat
# inside the conducted-comb idle spread (idle/spur carriers ride ~12-16 dB.c on the
# hot channels ch1/2/3) and false-opened on silence; 15 cleared the comb but clipped
# the weakest real keyings, which bottom out ~18-20 dB.c (ch4/120.950, ch7/121.700)
# -- and the effective bar is snr ABOVE the adaptive floor, so raw carrier_dbc runs
# higher than the number here. 11 recovers those weak keyings while staying above the
# flat comb. The one unsolvable case band-wide is ch4, whose comb (~20) overlaps its
# own signal (~19); if it false-opens, add it to --squelch-voice-gate-channels rather
# than raising this and re-clipping weak traffic elsewhere.
# --squelch-voice-gate-channels 9: enable the spectral-flatness voice gate on ONLY
# ch9 (122.975 S50 Auburn CTAF), the channel with the largest receive-power swing,
# where a band-wide noise burst most easily false-opens the squelch. The gate opens
# only on voice-like (tonal) audio and vetoes flat broadband noise. It is kept OFF
# on every other channel: it rejects non-tonal audio, and weak/distant tower
# transmissions are noisy enough to read as broadband -> a global gate vetoed and
# missed them. Widen the list (e.g. 9,12) if another channel needs it, or raise
# --squelch-voice-flatness (default 0.5) to admit noisier voice.
# --squelch-hysteresis-db 3: once open, hold until the level falls 3 dB below the
# open bar (close bar ~ snr-hyst = +5 dB.c). Lowered 6 -> 3 because a 6 dB spread
# put the close bar at ~+2 dB.c, buried in the 0-2 dB.c inter-over gap carrier, so
# a busy channel (ch4/120.950 tower) never fell below it and merged a whole
# multi-over exchange into one ~40 s open. +5 dB.c sits cleanly above the gap floor.
# --squelch-hang-ms 300: lowered from the 1000 ms VOX default. Carrier squelch sees
# the AM carrier (steady through an over, gone between overs), so it needs only
# enough hang to bridge intra-over modulation dips; 1 s bridged the ~1 s inter-over
# gaps and glued separate overs together. 300 ms closes promptly once the carrier
# drops without chopping a single over.
# --metrics-port 9108: serves Prometheus /metrics, a /healthz liveness probe, and
#   a /status JSON snapshot (Pluto reachability, link/data-flow, per-feed health).
# --monitor-port 8082: low-latency raw-PCM debug-listen (8081 is taken by the
#   PiAware web UI): GET /listen/<ch>.wav?tap=pre|post (no Icecast/MP3); coexists
#   with the feeds.
# --mqtt-* -> Home Assistant: broker/user come from the EnvironmentFile. The
#   password is deliberately NOT a flag: the reader reads AIRBAND_MQTT_PASS straight
#   from the environment, because a flag value lands in /proc/<pid>/cmdline where
#   every local user (and `systemctl status`) can read it. An empty
#   ${AIRBAND_MQTT_BROKER} (var unset) disables MQTT in-reader, so this line is
#   safe whether or not the broker is configured — no separate "MQTT off" variant.
# Stats: with stdout on the journal (not a TTY) the reader logs a one-line summary
#   every 60 s instead of the 18-row table every 5 s; add --stats-table to get the
#   table back (it duplicates /metrics and /status, and filled the 4 GB journal).
ExecStart=/home/pi/pluto-airband/host/target/release/airband-reader plutoplus.chongflix.tv:30000 --feeds /home/pi/pluto-airband/feeds.json --channels 18 --rate 20000 --squelch carrier --squelch-snr 11 --squelch-hysteresis-db 3 --squelch-hang-ms 300 --squelch-voice-gate-channels 9 --metrics-port 9108 --monitor-port 8082 --mqtt-broker ${AIRBAND_MQTT_BROKER} --mqtt-user ${AIRBAND_MQTT_USER}
# Failure alerting. systemd runs this after EVERY stop (also when ExecStart itself
# failed or timed out) with $SERVICE_RESULT/$EXIT_CODE/$EXIT_STATUS set. The
# script exits 0 silently on SERVICE_RESULT=success (a clean `systemctl
# stop/restart`, including the external watchdog's recovery restart) and
# otherwise logs + POSTs to $AIRBAND_ALERT_URL from the EnvironmentFile above
# (crash, signal, WatchdogSec timeout, OOM kill, start timeout). It runs as
# User=pi inside the sandbox below, which is all curl needs. Root-owned copy
# installed by deploy/install.sh. Bounded by `curl -m 10` < TimeoutStopSec, so it
# never delays the Restart= below by more than that.
ExecStopPost=/usr/local/sbin/airband-alert.sh %n
# airband-reader reconnects to the Pluto and to Icecast on its own, so this only
# fires on a real crash. Wait between restarts so a wedged Pluto isn't hammered.
Restart=always
RestartSec=5
# Default KillSignal (SIGTERM): the reader installs NO signal handler, so there is
# no graceful shutdown to trigger — a `systemctl stop` just terminates it and the
# Icecast servers notice the dropped source sockets within seconds (an earlier
# KillSignal=SIGINT line here claimed otherwise and was wrong). TimeoutStopSec is
# kept so a reader wedged in an uninterruptible write still gets SIGKILLed
# promptly; it also bounds the ExecStopPost hook above.
TimeoutStopSec=15
# Single instance is inherent to a systemd service; keep memory/FD headroom for
# 18 eager DeepFilterNet models (~10-15 MB each) plus encoders.
LimitNOFILE=4096
# CPU priority. The reader runs ~190% CPU of real-time DSP (18 DeepFilterNet
# channels) on a Pi 5 that also hosts the ADS-B docker stack and has been seen
# thermally throttled (soft temp limit, no fan). Nice=-10 wins scheduler ties
# against ordinary processes; CPUWeight=1000 (default 100) does the same at the
# cgroup level against the docker slice when the whole box is saturated, so audio
# keeps its deadlines and the feeders, not the reader, lose cycles.
Nice=-10
CPUWeight=1000
# Guard against a runaway leak: well above normal RSS (models + tract buffers +
# encoders, a few hundred MB), so this only trips on a real leak. On breach the
# cgroup OOM-kills the reader and Restart=always brings it back clean.
# MemorySwapMax=0 keeps a real-time process out of swap (a swapped tract buffer is
# an audio dropout). NOTE: rf-pi currently boots with cgroup_disable=memory on the
# kernel cmdline (cgroup.controllers lacks "memory"), so MemoryMax, MemorySwapMax
# and OOMPolicy are inert until the controller is enabled in cmdline.txt and the
# Pi rebooted; they are kept so that reboot is the only step needed.
# OOMScoreAdjust is a plain per-process knob (no cgroup needed): under host-wide
# memory pressure the kernel kills the ADS-B containers before the feeder.
MemoryMax=1500M
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=-500

# --- Sandbox -----------------------------------------------------------------
# Conservative hardening (systemd-analyze security scored the bare unit 9.2
# UNSAFE). The reader in --feeds mode needs only: read access to the binary,
# feeds.json and the models (embedded), outbound TCP (Pluto :30000/:8000, Icecast,
# LiveATC TLS, MQTT), two listening TCP ports (:9108 metrics, :8082 monitor), DNS,
# and the AF_UNIX sd_notify socket. It writes nothing: the deployed ExecStart has
# no --mode wav/raw, so the --out-dir recorder path (main.rs: create_dir_all only
# when mode != stats) is never taken — hence the whole tree, /home included, is
# read-only. If you ever add --mode wav here, add
# ReadWritePaths=<the --out-dir> too. SystemCallFilter and MemoryDenyWriteExecute
# are deliberately NOT set (tract/DFN inference; not worth a silent SIGSYS).
# Devices: closed policy with exactly one allowance, /dev/vcio (the firmware
# mailbox), so the host thermal probe can run `vcgencmd get_throttled` — the Pi 5
# exposes the throttle bits nowhere in sysfs. The `pi` user is in `video`, which
# owns the node. No ALSA (that is airband-listen). An empty CapabilityBoundingSet
# is a no-op for User=pi but documents the intent.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/vcio r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
